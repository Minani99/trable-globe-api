# Copy to .env.local and adjust as needed. .env.local is git-ignored.
#
# Server-side target for Server Components and the same-origin /api proxy.
# Defaults to http://localhost:8080 when unset.
API_BASE_URL=http://localhost:8080

# Canonical public URL used for metadata, sitemap and social previews.
# SITE_URL=https://travel-globe.example.com

# Optional: expose a separate API URL directly to browsers instead of using the proxy.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional comma-separated hostnames/IPs in addition to auto-detected LAN IPv4 addresses.
# NEXT_ALLOWED_DEV_ORIGINS=travel-globe.local

# Optional photo storage. Create an R2 bucket, API token and public custom domain.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=travel-globe-photos
# R2_PUBLIC_BASE_URL=https://images.example.com
